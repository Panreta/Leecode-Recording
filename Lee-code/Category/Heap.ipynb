   "source": [
    "import heapq\n",
    "\n",
    "nums = [3, 1, 4, 1, 5, 9]\n",
    "\n",
    "print(heapq.heapify(nums)    )    # turn list into a heap in-place\n",
    "print(heapq.heappush(nums, 7)    )    # push a value\n",
    "print(heapq.heappop(nums)        )    # pop the SMALLEST value"
   ]
  }
